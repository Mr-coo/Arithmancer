# DOMAIN is a domain name (HTTPS certificate fetched automatically) or :80 (plain HTTP)
{$DOMAIN} {
	root * /srv

	# Vite puts a hash in the names of the files under /assets, so they never change and browsers can keep them. The
	# page itself is checked on every load, so a deploy shows up right away.
	@hashed path /assets/*
	@page not path /assets/*

	# Files of the built frontend are served directly; everything else (/ws, /api, ...) goes to Spring Boot
	@frontend file {path} {path}/index.html
	handle @frontend {
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy backend:8080
	}
}
