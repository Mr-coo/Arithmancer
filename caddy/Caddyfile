# DOMAIN is a domain name (HTTPS certificate fetched automatically) or :80 (plain HTTP)
{$DOMAIN} {
	root * /srv

	# Files of the built frontend are served directly; everything else (/ws, /api, ...) goes to Spring Boot
	@frontend file {path} {path}/index.html
	handle @frontend {
		file_server
	}
	handle {
		reverse_proxy backend:8080
	}
}
